# Grasshopper — ESP-IDF defaults. menuconfig changes go here so they
# survive a clean build.

# Target
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

# Flash & PSRAM (ESP32-S3 WROOM N8R8 / GOOUUU clone — 8 MB flash, 8 MB OPI PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Partition table (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Console: UART0 → CH340 bridge → /dev/ttyUSB0 on the host. Same as Fox,
# because the GOOUUU board's native USB-C port is silent on these clones
# (Espressif 303a:1001 enumerates but emits no characters). Phase 3+ may
# revisit if a clean ESP-IDF native CDC works on a fresh board.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Main task: needs room for setup + JSON serializers
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Arduino-as-component (used only for the Lepton SPI HAL — see
# components/hal_lepton). We provide our own app_main, so don't auto-
# start Arduino's setup() / loop().
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_FREERTOS_HZ=1000

# Wi-Fi: stock defaults for phase 2; revisit when heap budget gets tight.
# (Manual override — STATIC=4 — broke the IDF v5.3 build because the
# default RX_BA_WIN of 6 must be ≤ 2 × static buffers.)

# TLS: use the bundled cert chain so wss:// works without provisioning
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Bootloader / image
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y
